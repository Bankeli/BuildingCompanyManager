@page
@model LoginModel

@{
    ViewData["Title"] = "Sign in";
}

<section class="identity-page" aria-labelledby="login-title">
    <header class="identity-page-header">
        <p class="identity-eyebrow">Builder Manager</p>
        <h1 id="login-title">Sign in</h1>
        <p>Access your company workspace and daily operations.</p>
    </header>

    <form id="account" method="post" class="identity-form">
        <div asp-validation-summary="ModelOnly" class="identity-validation" role="alert"></div>

        <div class="form-floating">
            <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" />
            <label asp-for="Input.Email"></label>
            <span asp-validation-for="Input.Email" class="identity-field-validation"></span>
        </div>

        <div class="form-floating">
            <input asp-for="Input.Password" class="form-control" autocomplete="current-password" aria-required="true" placeholder="Password" />
            <label asp-for="Input.Password"></label>
            <span asp-validation-for="Input.Password" class="identity-field-validation"></span>
        </div>

        <label class="identity-checkbox" asp-for="Input.RememberMe">
            <input class="form-check-input" asp-for="Input.RememberMe" />
            @Html.DisplayNameFor(model => model.Input.RememberMe)
        </label>

        <button id="login-submit" type="submit" class="btn app-btn-primary identity-submit">Sign in</button>

        <div class="identity-links">
            <a id="forgot-password" asp-page="./ForgotPassword">Forgot your password?</a>
            <a asp-area="" asp-controller="CompanyRegistration" asp-action="Register">Register company</a>
        </div>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
