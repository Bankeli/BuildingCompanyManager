@using BuildingCompanyManager.Data.Enums
@model BuildingCompanyManager.Models.Employees.EmployeeCreationInputModel

@{
    ViewData["Title"] = "Add employee";
}

<section class="form-page" aria-labelledby="add-employee-title">
    <div class="form-page-header">
        <a class="back-link" asp-action="Index">Back to employees</a>
        <h1 id="add-employee-title">Add employee</h1>
        <p>Create an employee account and generate a temporary password.</p>
    </div>

    <form class="app-form" asp-action="Add" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

        <div class="form-row-grid">
            <div class="form-group">
                <label asp-for="FirstName"></label>
                <input asp-for="FirstName" class="form-control" autocomplete="given-name" />
                <span asp-validation-for="FirstName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="LastName"></label>
                <input asp-for="LastName" class="form-control" autocomplete="family-name" />
                <span asp-validation-for="LastName" class="text-danger"></span>
            </div>
        </div>

        <div class="form-group">
            <label asp-for="Email"></label>
            <input asp-for="Email" class="form-control" autocomplete="email" />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>

        <div class="form-row-grid">
            <div class="form-group">
                <label asp-for="Role"></label>
                <select asp-for="Role" class="form-select">
                    <option value="">Select role</option>
                    <option value="@((int)EmployeeRole.TechnicalManager)">Technical manager</option>
                    <option value="@((int)EmployeeRole.Foreman)">Foreman</option>
                    <option value="@((int)EmployeeRole.Worker)">Worker</option>
                </select>
                <span asp-validation-for="Role" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="DailyRate"></label>
                <input asp-for="DailyRate" class="form-control" min="0.01" step="0.01" />
                <span asp-validation-for="DailyRate" class="text-danger"></span>
            </div>
        </div>

        <div class="form-group">
            <label asp-for="JobTitle"></label>
            <input asp-for="JobTitle" class="form-control" />
            <span asp-validation-for="JobTitle" class="text-danger"></span>
        </div>

        <div class="form-actions">
            <a class="btn app-btn-secondary" asp-action="Index">Cancel</a>
            <button type="submit" class="btn app-btn-primary">Create employee account</button>
        </div>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
