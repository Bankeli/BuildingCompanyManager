@using BuildingCompanyManager.Data.Enums
@model BuildingCompanyManager.Models.Employees.EmployeeDetailsViewModel

@{
    ViewData["Title"] = "Employee profile";
}

@functions {
    private static string GetRoleName(EmployeeRole role) => role switch
    {
        EmployeeRole.Owner => "Owner",
        EmployeeRole.TechnicalManager => "Technical manager",
        EmployeeRole.Foreman => "Foreman",
        EmployeeRole.Worker => "Worker",
        _ => "Unknown"
    };

    private static string GetProjectStatusName(ProjectStatus status) => status switch
    {
        ProjectStatus.Planning => "Planning",
        ProjectStatus.Active => "Active",
        ProjectStatus.OnHold => "On hold",
        ProjectStatus.Completed => "Completed",
        ProjectStatus.Cancelled => "Cancelled",
        _ => "Unknown"
    };
}

<section class="employee-profile-page" aria-labelledby="employee-profile-title">
    <header class="employee-profile-header">
        <div>
            <a class="back-link" asp-action="Index">Back to employees</a>
            <h1 id="employee-profile-title">@Model.FirstName @Model.LastName</h1>
            <p>@GetRoleName(Model.Role) - @Model.JobTitle</p>
        </div>
        <div class="employee-profile-header-actions">
            @if (Model.Role != EmployeeRole.Owner)
            {
                <a class="btn app-btn-primary" asp-action="Edit" asp-route-id="@Model.Id">Edit employment</a>
            }
            <span class="status-label @(Model.IsActive ? "status-label-active" : "status-label-inactive")">
                @(Model.IsActive ? "Active" : "Inactive")
            </span>
        </div>
    </header>

    <div class="employee-profile-grid">
        <section class="employee-profile-section" aria-labelledby="account-title">
            <h2 id="account-title">Account and contact</h2>
            <dl>
                <div>
                    <dt>Email</dt>
                    <dd>@Model.Email</dd>
                </div>
                <div>
                    <dt>Phone number</dt>
                    <dd>@(Model.PhoneNumber ?? "Not provided")</dd>
                </div>
            </dl>
        </section>

        <section class="employee-profile-section" aria-labelledby="employment-title">
            <h2 id="employment-title">Employment</h2>
            <dl>
                <div>
                    <dt>Role</dt>
                    <dd>@GetRoleName(Model.Role)</dd>
                </div>
                <div>
                    <dt>Job title</dt>
                    <dd>@Model.JobTitle</dd>
                </div>
                <div>
                    <dt>Daily rate</dt>
                    <dd>@(Model.DailyRate is decimal dailyRate ? $"{dailyRate:F2}" : "Not applicable")</dd>
                </div>
            </dl>
        </section>

        <section class="employee-profile-section" aria-labelledby="crew-title">
            <h2 id="crew-title">Crew assignment</h2>
            @if (Model.CrewAssignments.Count == 0)
            {
                <p class="employee-profile-empty">This employee is not assigned to or responsible for an active crew.</p>
            }
            else
            {
                <ul class="employee-crew-list">
                    @foreach (var crew in Model.CrewAssignments)
                    {
                        <li>
                            <strong>@crew.Name</strong>
                            <span>Technical manager: @crew.TechnicalManagerName</span>
                            <span>Foreman: @crew.ForemanName</span>
                        </li>
                    }
                </ul>
            }
        </section>

        <section class="employee-profile-section" aria-labelledby="projects-title">
            <h2 id="projects-title">Project assignments</h2>
            @if (Model.ProjectAssignments.Count == 0)
            {
                <p class="employee-profile-empty">This employee is not assigned to or responsible for a project.</p>
            }
            else
            {
                <ul class="employee-project-list">
                    @foreach (var project in Model.ProjectAssignments)
                    {
                        <li>
                            <a asp-controller="Projects" asp-action="ManageCrews" asp-route-id="@project.Id">@project.Name</a>
                            <span>@project.ClientName - @GetProjectStatusName(project.Status)</span>
                            @if (project.IsTechnicalManager)
                            {
                                <span>Technical manager</span>
                            }
                            @if (project.CrewNames.Count > 0)
                            {
                                <span>Crew: @string.Join(", ", project.CrewNames)</span>
                            }
                        </li>
                    }
                </ul>
            }
        </section>
    </div>
</section>
