@using BuildingCompanyManager.Common


@{
    ViewData[ApplicationConstants.ViewTitleKey] = HomePageTexts.Title;
}

<div class="home-page">
    @if (TempData[RouteConstants.CompanyRegistrationSuccessMessageKey] is string successMessage)
    {
        <div class="alert alert-success mb-0" role="status">@successMessage</div>
    }

    <section class="home-hero" aria-labelledby="home-title">
        <div class="home-hero-content">
            <p class="home-eyebrow">@HomePageTexts.Eyebrow</p>
            <h1 id="home-title">@HomePageTexts.Title</h1>
            <p class="home-summary">
                @HomePageTexts.Summary
            </p>
            <div class="home-actions">
                <a class="btn app-btn-primary"
                   asp-controller="@RouteConstants.CompanyRegistrationController"
                   asp-action="@RouteConstants.RegisterAction">
                    @HomePageTexts.RegisterCompany
                </a>
                <a class="btn app-btn-secondary"
                   asp-area="@IdentityRouteConstants.AreaName"
                   asp-page="@IdentityRouteConstants.LoginPage">
                    @HomePageTexts.SignIn
                </a>
            </div>
        </div>
    </section>

    <section class="home-modules" aria-label="@HomePageTexts.ModulesLabel">
        <div class="home-modules-inner">
            <span>@HomePageTexts.Companies</span>
            <span>@HomePageTexts.Crews</span>
            <span>@HomePageTexts.Attendance</span>
            <span>@HomePageTexts.Projects</span>
        </div>
    </section>
</div>
