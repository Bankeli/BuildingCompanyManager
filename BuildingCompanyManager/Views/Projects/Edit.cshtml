@model BuildingCompanyManager.Models.Projects.ProjectFormViewModel

@{
    ViewData["Title"] = "Edit project";
}

<section class="form-page" aria-labelledby="edit-project-title">
    <div class="form-page-header">
        <a class="back-link" asp-action="Index">Back to projects</a>
        <h1 id="edit-project-title">Edit project</h1>
        <p>Update the project details, status or Technical Manager.</p>
    </div>

    <form class="app-form" asp-action="Edit" method="post">
        <input asp-for="Id" type="hidden" />
        <partial name="_ProjectForm" model="Model" />
        <div class="form-actions">
            <a class="btn app-btn-secondary" asp-action="Index">Cancel</a>
            <button type="submit" class="btn app-btn-primary">Save changes</button>
        </div>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
