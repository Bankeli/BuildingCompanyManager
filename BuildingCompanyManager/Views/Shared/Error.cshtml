@model ErrorViewModel
@{
    ViewData[ApplicationConstants.ViewTitleKey] = ErrorPageTexts.PageTitle;
}

<h1 class="text-danger">@ErrorPageTexts.Heading</h1>
<h2 class="text-danger">@ErrorPageTexts.Description</h2>

@if (Model.ShowRequestId)
{
    <p>
        <strong>@ErrorPageTexts.RequestId</strong> <code>@Model.RequestId</code>
    </p>
}

<h3>@ErrorPageTexts.DevelopmentMode</h3>
<p>
    @ErrorPageTexts.DevelopmentInformation
</p>
<p>
    <strong>@ErrorPageTexts.DevelopmentWarning</strong>
    @ErrorPageTexts.SensitiveInformationWarning
    @ErrorPageTexts.LocalDebuggingInstructions
</p>
