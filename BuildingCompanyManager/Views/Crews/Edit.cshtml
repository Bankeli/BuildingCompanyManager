@model BuildingCompanyManager.Models.Crews.CrewFormViewModel

@{
    ViewData["Title"] = "Edit crew";
}

<section class="form-page" aria-labelledby="edit-crew-title">
    <div class="form-page-header">
        <a class="back-link" asp-action="Index">Back to crews</a>
        <h1 id="edit-crew-title">Edit crew</h1>
        <p>Update the crew leadership and worker list.</p>
    </div>

    <form class="app-form" asp-action="Edit" method="post">
        <input asp-for="Id" type="hidden" />
        <partial name="_CrewForm" model="Model" />
        <div class="form-actions">
            <a class="btn app-btn-secondary" asp-action="Index">Cancel</a>
            <button type="submit" class="btn app-btn-primary">Save changes</button>
        </div>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
