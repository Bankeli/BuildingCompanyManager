@model BuildingCompanyManager.Models.Crews.CrewFormViewModel

@{
    ViewData["Title"] = "Create crew";
}

<section class="form-page" aria-labelledby="create-crew-title">
    <div class="form-page-header">
        <a class="back-link" asp-action="Index">Back to crews</a>
        <h1 id="create-crew-title">Create crew</h1>
        <p>Set the people responsible for the crew and add available Workers.</p>
    </div>

    <form class="app-form" asp-action="Create" method="post">
        <partial name="_CrewForm" model="Model" />
        <div class="form-actions">
            <a class="btn app-btn-secondary" asp-action="Index">Cancel</a>
            <button type="submit" class="btn app-btn-primary">Create crew</button>
        </div>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
