@model BuildingCompanyManager.Models.Attendance.AttendanceCreateInputModel

@{
    ViewData["Title"] = "Record working hours";
}

<section class="form-page" aria-labelledby="record-hours-title">
    <header class="form-page-header">
        <a class="back-link" asp-action="Index" asp-route-workDate="@Model.WorkDate.ToString("yyyy-MM-dd")">Back to attendance</a>
        <h1 id="record-hours-title">Record working hours</h1>
        <p>@Model.EmployeeName</p>
    </header>

    <dl class="attendance-context">
        <div>
            <dt>Work date</dt>
            <dd>@Model.WorkDate.ToString("dd MMM yyyy")</dd>
        </div>
    </dl>

    <form asp-action="Create" method="post" class="app-form">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <input asp-for="EmployeeId" type="hidden" />
        <input asp-for="WorkDate" type="hidden" />

        @if (Model.AvailableProjectCrews.Count == 0)
        {
            <p class="management-empty-state">This employee has no active project assignment for the selected date.</p>
        }
        else
        {
            <div class="form-group">
                <label asp-for="ProjectCrewId"></label>
                <select asp-for="ProjectCrewId" class="form-select">
                    <option value="">Select project assignment</option>
                    @foreach (var assignment in Model.AvailableProjectCrews)
                    {
                        <option value="@assignment.Id">@assignment.ProjectName - @assignment.CrewName</option>
                    }
                </select>
                <span asp-validation-for="ProjectCrewId" class="text-danger"></span>
            </div>

            <div class="form-row-grid">
                <div class="form-group">
                    <label asp-for="WorkedHours"></label>
                    <input asp-for="WorkedHours" class="form-control" type="number" min="0" max="24" step="0.25" />
                    <span asp-validation-for="WorkedHours" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="ExtraHours"></label>
                    <input asp-for="ExtraHours" class="form-control" type="number" min="0" max="24" step="0.25" />
                    <span asp-validation-for="ExtraHours" class="text-danger"></span>
                </div>
            </div>

            <div class="form-group">
                <label asp-for="BonusAmount"></label>
                <input asp-for="BonusAmount" class="form-control" type="number" min="0" step="0.01" />
                <span asp-validation-for="BonusAmount" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="ForemanComment"></label>
                <textarea asp-for="ForemanComment" class="form-control" rows="4"></textarea>
                <span asp-validation-for="ForemanComment" class="text-danger"></span>
            </div>
        }

        <div class="form-actions">
            <a class="btn app-btn-secondary" asp-action="Index" asp-route-workDate="@Model.WorkDate.ToString("yyyy-MM-dd")">Cancel</a>
            @if (Model.AvailableProjectCrews.Count > 0)
            {
                <button class="btn app-btn-primary" type="submit">Save hours</button>
            }
        </div>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
