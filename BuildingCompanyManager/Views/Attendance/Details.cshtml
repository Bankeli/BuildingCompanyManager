@model BuildingCompanyManager.Models.Attendance.AttendanceEmployeeDetailsViewModel

@{
    ViewData["Title"] = "Working hours";
}

<section class="attendance-details-page" aria-labelledby="attendance-details-title">
    <header class="attendance-details-header">
        <div class="attendance-details-identity">
            @if (Model.CanReturnToAttendance)
            {
                <a class="attendance-back-link" asp-action="Index"><span aria-hidden="true">&larr;</span> Back to attendance</a>
            }
            else
            {
                <a class="attendance-back-link" asp-controller="Home" asp-action="Index"><span aria-hidden="true">&larr;</span> Back to home</a>
            }

            <div class="attendance-employee-summary">
                <div class="attendance-employee-avatar" aria-hidden="true">@Model.EmployeeInitials</div>
                <div>
                    <p class="attendance-company-name">@Model.CompanyName</p>
                    <h1 id="attendance-details-title">@Model.EmployeeName</h1>
                    <p class="attendance-details-subtitle">Monthly working hours overview</p>
                </div>
            </div>
        </div>
        <div class="attendance-month-total">
            <span>Total this month</span>
            <strong>@Model.TotalWorkedHours.ToString("0.##") <small>h</small></strong>
        </div>
    </header>

    <nav class="attendance-month-navigation" aria-label="Attendance month navigation">
        @if (Model.CanNavigateToPreviousMonth)
        {
            var previousMonth = new DateOnly(Model.Year, Model.Month, 1).AddMonths(-1);
            <a class="attendance-month-button" asp-action="Details" asp-route-employeeId="@Model.EmployeeId" asp-route-year="@previousMonth.Year" asp-route-month="@previousMonth.Month" aria-label="View previous month">&lsaquo;</a>
        }
        else
        {
            <span class="attendance-month-button pagination-disabled" aria-disabled="true">&lsaquo;</span>
        }
        <span class="attendance-month-title">@Model.MonthName @Model.Year</span>
        @if (Model.CanNavigateToNextMonth)
        {
            var nextMonth = new DateOnly(Model.Year, Model.Month, 1).AddMonths(1);
            <a class="attendance-month-button" asp-action="Details" asp-route-employeeId="@Model.EmployeeId" asp-route-year="@nextMonth.Year" asp-route-month="@nextMonth.Month" aria-label="View next month">&rsaquo;</a>
        }
        else
        {
            <span class="attendance-month-button pagination-disabled" aria-disabled="true">&rsaquo;</span>
        }
    </nav>

    <section class="attendance-calendar" aria-label="Working hours calendar">
        <div class="attendance-calendar-weekdays" aria-hidden="true">
            <span>Mon</span>
            <span>Tue</span>
            <span>Wed</span>
            <span>Thu</span>
            <span>Fri</span>
            <span class="attendance-weekend-heading">Sat</span>
            <span class="attendance-weekend-heading">Sun</span>
        </div>
        <div class="attendance-calendar-days">
            @foreach (var day in Model.CalendarDays)
            {
                @if (day.Date is null)
                {
                    <div class="attendance-calendar-day attendance-calendar-day-empty" aria-hidden="true"></div>
                }
                else
                {
                    <div class="attendance-calendar-day @(day.IsToday ? "attendance-calendar-day-today" : string.Empty) @(day.IsWeekend ? "attendance-calendar-day-weekend" : string.Empty)">
                        <div class="attendance-calendar-day-heading">
                            <time datetime="@day.Date.Value.ToString("yyyy-MM-dd")">@day.Date.Value.Day</time>
                            @if (day.IsToday)
                            {
                                <span class="attendance-today-label">Today</span>
                            }
                        </div>
                        <strong class="attendance-calendar-hours">@day.WorkedHours!.Value.ToString("0.##") <small>h</small></strong>
                        @if (day.HasBonus || day.HasComment)
                        {
                            <div class="attendance-calendar-flags">
                                @if (day.HasBonus)
                                {
                                    <span class="attendance-bonus-flag">Bonus @day.BonusAmount.ToString("0.##")</span>
                                }
                                @if (day.HasComment)
                                {
                                    <span class="attendance-comment-flag">Comment</span>
                                }
                            </div>
                        }
                    </div>
                }
            }
        </div>
    </section>

    @{
        var daysWithNotes = Model.CalendarDays
            .Where(day => day.Date is not null && (day.HasBonus || day.HasComment))
            .ToArray();
    }

    @if (daysWithNotes.Length > 0)
    {
        <section class="attendance-day-insights" aria-labelledby="attendance-notes-title">
            <div class="attendance-day-insights-heading">
                <h2 id="attendance-notes-title">Day notes and bonuses</h2>
                <p>Additional information recorded for this month.</p>
            </div>
            <ul class="attendance-day-insights-list">
                @foreach (var day in daysWithNotes)
                {
                    <li>
                        <time datetime="@day.Date!.Value.ToString("yyyy-MM-dd")">@day.Date.Value.Day @Model.MonthName</time>
                        <div>
                            @if (day.HasBonus)
                            {
                                <p class="attendance-insight-bonus">Bonus: @day.BonusAmount.ToString("0.##")</p>
                            }
                            @if (day.HasComment)
                            {
                                <p class="attendance-insight-comment">@day.ForemanComment</p>
                            }
                        </div>
                    </li>
                }
            </ul>
        </section>
    }
</section>
